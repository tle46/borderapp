# Public browser configuration. Never put secrets in VITE_ variables.
# Same-origin API endpoint for local Vite and Cloudflare Pages.
VITE_BORDER_DELAYS_API_URL=/api/borderdelays

# Server-side proxy target. Set the public HTTPS backend origin in Cloudflare.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Public CARTO basemap key. Set your own key in the hosting build environment.
VITE_CARTO_API_KEY=

# Refresh frequency in seconds (integer from 10 to 86400; default 60).
VITE_POLL_INTERVAL_SECONDS=60

